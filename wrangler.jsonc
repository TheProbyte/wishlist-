{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "thegiver",
	"compatibility_date": "2026-11-13",
	"compatibility_flags": ["nodejs_als"],
	"main": ".svelte-kit/cloudflare/_worker.js",
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"workers_dev": true,
	// Keep variables added in the Cloudflare dashboard when deploying.
	"keep_vars": true,
	"vars": {
		// Google sign-in. The client ID is public (Google shows it to everyone who signs in).
		// GOOGLE_CLIENT_SECRET is NOT here: add it in Cloudflare as a Secret
		// (Settings → Runtime variables and secrets → Add variable → Type: Secret).
		"GOOGLE_CLIENT_ID": "669224290367-saf0u77k5i6ap23ajgke7m0q91vlcj9o.apps.googleusercontent.com"
	},
	"preview_urls": true,
	"d1_databases": [
		{
			"binding": "DB",
			// No database_id on purpose: the first `wrangler deploy` creates a D1 database
			// called "the-giver" on your Cloudflare account, and later commands find it by name.
			"database_name": "the-giver",
			"migrations_dir": "migrations"
		}
	]
}
